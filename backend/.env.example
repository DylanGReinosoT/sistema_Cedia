# Copia este archivo como ".env" y completa los valores reales. ".env" nunca se commitea.

# --- Supabase / PostgreSQL ---
# Pooler transaccional (pgbouncer) — la usa el PrismaClient en runtime.
DATABASE_URL="postgresql://<usuario>:<password-url-encoded>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa — la usan `prisma db pull` / `prisma migrate`.
DIRECT_URL="postgresql://<usuario>:<password-url-encoded>@<host>.pooler.supabase.com:5432/postgres"

# --- App ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Auth (JWT propio, Opción B) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
