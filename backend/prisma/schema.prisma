generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["gestion_fondos"]
}

model cat_areas_conocimiento_espe {
  id        Int         @id @default(autoincrement())
  nombre    String      @unique @db.VarChar(150)
  proyectos proyectos[]

  @@schema("gestion_fondos")
}

model cat_areas_unesco {
  id                  Int                   @id @default(autoincrement())
  codigo              String                @unique @db.VarChar(10)
  nombre              String                @db.VarChar(200)
  cat_subareas_unesco cat_subareas_unesco[]

  @@schema("gestion_fondos")
}

model cat_campos_amplios {
  id                     Int                      @id @default(autoincrement())
  codigo                 String                   @unique @db.VarChar(10)
  nombre                 String                   @db.VarChar(200)
  cat_campos_especificos cat_campos_especificos[]

  @@schema("gestion_fondos")
}

model cat_campos_detallados {
  id                     Int                    @id @default(autoincrement())
  campo_especifico_id    Int
  codigo                 String                 @unique @db.VarChar(10)
  nombre                 String                 @db.VarChar(200)
  cat_campos_especificos cat_campos_especificos @relation(fields: [campo_especifico_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proyectos              proyectos[]

  @@index([campo_especifico_id], map: "idx_camposdet_especifico")
  @@schema("gestion_fondos")
}

model cat_campos_especificos {
  id                    Int                     @id @default(autoincrement())
  campo_amplio_id       Int
  codigo                String                  @unique @db.VarChar(10)
  nombre                String                  @db.VarChar(200)
  cat_campos_detallados cat_campos_detallados[]
  cat_campos_amplios    cat_campos_amplios      @relation(fields: [campo_amplio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([campo_amplio_id], map: "idx_camposesp_amplio")
  @@schema("gestion_fondos")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cat_departamentos {
  id                                                       Int                        @id @default(autoincrement())
  nombre                                                   String                     @unique @db.VarChar(150)
  tipo                                                     String                     @db.VarChar(20)
  facultad                                                 String?                    @db.VarChar(150)
  director_usuario_id                                      String?                    @db.Uuid
  activo                                                   Boolean                    @default(true)
  usuarios_cat_departamentos_director_usuario_idTousuarios usuarios?                  @relation("cat_departamentos_director_usuario_idTousuarios", fields: [director_usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_departamento_director")
  cat_grupos_investigacion                                 cat_grupos_investigacion[]
  proyectos                                                proyectos[]
  usuarios_usuarios_departamento_idTocat_departamentos     usuarios[]                 @relation("usuarios_departamento_idTocat_departamentos")

  @@schema("gestion_fondos")
}

model cat_disciplinas_cientificas {
  id        Int         @id @default(autoincrement())
  nombre    String      @unique @db.VarChar(150)
  proyectos proyectos[]

  @@schema("gestion_fondos")
}

model cat_dominios_academicos {
  id                       Int                        @id @default(autoincrement())
  nombre                   String                     @unique @db.VarChar(200)
